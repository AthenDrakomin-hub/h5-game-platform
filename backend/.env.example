# ============================================================
# H5 Game 生产环境变量模板
# 用法: cp .env.example /opt/h5-game/.env && chmod 600 /opt/h5-game/.env
# systemd: EnvironmentFile=/opt/h5-game/.env
# ============================================================

# ----- 数据库 -----
DB_URL=jdbc:mysql://127.0.0.1:3306/h5_game?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=h5_app
DB_PASSWORD=__必须改成强密码__
DB_POOL_MAX=15
DB_POOL_MIN=3

# ----- JWT（必须改成 64 位以上随机串） -----
JWT_SECRET=__openssl rand -hex 32 生成__
JWT_EXPIRATION=86400000

# ----- 站点 -----
SITE_NAME=NOVA 新星娱乐
SITE_DOMAIN=https://h5.goodspage.cn

# ----- 管理员初始化 -----
# 留空 = 首次启动随机生成 16 位密码，只打印一次到 journalctl -u h5-backend
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ----- Telegram（C 端唯一登录方式） -----
TELEGRAM_BOT_TOKEN=__@BotFather 获取__

# ----- 登录后门（生产默认 false，只允许 Telegram initData 登录） -----
ALLOW_PASSWORD_LOGIN=false

# ----- CORS 白名单（逗号分隔） -----
CORS_ALLOWED_ORIGINS=https://h5.goodspage.cn

# ----- 开奖 -----
DRAW_ENABLED=true
DRAW_MARKSIX6_ENABLED=true
DRAW_MARKSIX6_URL=https://api3.marksix6.net/lottery_api.php

# ----- USDT 自动到账 -----
USDT_TRX_ENABLED=true
USDT_GRID_API=https://api.trongrid.io
USDT_GRID_KEY=
USDT_POLL_INTERVAL=5000

# ----- Redis（可选，不装则限流降级为内存） -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ----- 服务端口 -----
SERVER_PORT=8888

# ----- 日志 -----
LOG_LEVEL=info
LOG_FILE=/opt/h5-game/logs/backend.log

# ----- API 文档（生产默认关闭） -----
SPRINGDOC_ENABLED=false
