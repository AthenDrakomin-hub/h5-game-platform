# Telegram Bot 配置
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=@NOVA_Lucky_Bot

# 运行模式: webhook | polling
BOT_MODE=polling

# Webhook 配置（BOT_MODE=webhook 时使用）
WEBHOOK_URL=https://your-domain.com/bot/webhook
WEBHOOK_PORT=3001
WEBHOOK_SECRET=random_secret_string

# Mini App URL（H5 地址，必须 HTTPS）
MINI_APP_URL=https://your-h5-domain.com

# 后端 API 地址
API_BASE_URL=http://127.0.0.1:8888/api

# 后端内部通知密钥（后端调用 Bot 通知接口时鉴权）
BOT_INTERNAL_SECRET=your_internal_secret_here

# 管理员 Telegram ID（可多个，逗号分隔）
ADMIN_TELEGRAM_IDS=

# 日志级别: debug | info | warn | error
LOG_LEVEL=info
